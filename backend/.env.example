# server
BACKEND_ADDR=:8080
# REQUIRED in production. The server refuses to start in release mode with an
# empty or default secret. Generate one, e.g. `openssl rand -hex 32`.
JWT_SECRET=dev_secret_change_me

# auth
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# Set only for local development. When "true", exposes /auth/mock-login, which
# mints a valid JWT for any nickname with no credentials. Never enable in prod.
ENABLE_MOCK_LOGIN=false
# Optional. Password for the root admin bootstrapped on first start (only when
# no active admin exists). If unset, a random password is generated and logged
# once. Log in and change it immediately.
ADMIN_INIT_PASSWORD=
# Nickname used only when bootstrapping a new root admin. If the nickname is
# occupied and no active admin exists, startup fails until an unused value is set.
ADMIN_INIT_NICKNAME=admin

# rate limits (0 disables that bucket)
# Register and password-login requests per minute, counted per source IP.
RATE_LIMIT_AUTH_PER_MIN=60
# Wrong-password attempts per minute, counted per normalized account name.
# Correct credentials are always checked and successful login clears failures.
RATE_LIMIT_ACCOUNT_FAILURES_PER_MIN=10
# Silent WeChat login and refresh requests per minute, counted per source IP.
RATE_LIMIT_SESSION_PER_MIN=600
# Smart-draft calls per hour per user — each one is a paid DeepSeek request.
RATE_LIMIT_SMART_DRAFT_PER_HOUR=30
# Recommendation exposure/click reports per minute per user or IP.
RATE_LIMIT_FEEDBACK_PER_MIN=120

# redis + websocket
USE_REDIS=true
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
WS_ENABLED=true
# Tests only: explicitly names the isolated Redis instance that tests may clear.
# Leave unset outside a disposable test run.
REDIS_TEST_ADDR=

# admin web CORS: comma-separated allowed origins (in addition to localhost dev)
ADMIN_WEB_ORIGIN=
# Comma-separated proxy IPs/CIDRs whose forwarded headers Gin may trust.
# Empty means use the direct peer address and ignore forwarded client IPs.
TRUSTED_PROXIES=

# smart post (DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=
SMART_POST_TIMEZONE=Asia/Shanghai
